    "\\bplease (add|make|fix|bring)\\b",
    "\\bwould be (nice|great|good|helpful)\\b",
    "\\bwould love\\b",
    "\\bneeds? (a|an|the|to|more)\\b",
    "\\bno way to\\b",
    "\\bthere'?s no (way|option)\\b",
    "\\b(can'?t|cannot|unable to) (even )?(add|change|edit|set|choose|export|undo|delete|turn off|draw|play|use)\\b",
    "\\b(missing|lacks|lacking)\\b",
    "\\bdoesn'?t (have|support|let|allow)\\b",
    "\\bif only\\b",
    "\\bwhy (can'?t|isn'?t|doesn'?t)\\b",
    "\\bdeber[ií]an?\\b",
    "\\bojal[aá]\\b",
    "\\bporfa(vor)?\\b",
    "\\bme gustar[ií]a\\b",
    "\\bagreguen?\\b",
    "\\bpongan?\\b",
    "\\bquiero que\\b"
