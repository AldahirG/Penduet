    {"id": "energy", "label": "Energy / credits: you run out and have to wait or pay", "kind": "complaint",
     "patterns": ["\\benergy\\b", "\\bcredits?\\b", "\\benerg[ií]a\\b", "\\bvidas?\\b", "\\bone drawing a day\\b"]},
    {"id": "billing", "label": "Billing, cancelling and trials that charge", "kind": "complaint",
     "patterns": ["\\bcharged?\\b", "\\brefund", "\\bcancel(l?ing|l?ed|lation)?\\b", "\\bauto.?renew", "\\btake \\$?\\d+", "\\bscam\\b", "\\bcredit card\\b", "\\btrial\\b", "\\bcobr(a|an|o|ar|aron|ado)\\b", "\\breembols", "\\bcancelar\\b", "\\bestafa\\b", "\\bfraude\\b", "\\bsuscripci[oó]n\\b"]},
    {"id": "ads", "label": "Ads", "kind": "complaint",
