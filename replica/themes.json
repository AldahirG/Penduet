    {"id": "multiplayer_promise", "label": "Advertised as drawing with other people, but you barely can", "kind": "complaint",
     "patterns": ["\\bmulti[- ]?player\\b", "\\bdraw(ing)? with (other|people|friends|strangers|someone|others)", "\\bwith (friends|people|others|strangers)\\b", "\\b2 player\\b", "\\bduo\\b", "\\bbots?\\b", "\\badvertis", "\\bmultijugador\\b", "\\bcon amigos\\b", "\\bcon otras personas\\b", "\\bjugar con\\b", "\\bdibujar con\\b", "\\bpublicidad engañosa\\b"]},
    {"id": "creativity", "label": "Too strict: tracing and colouring in, no freedom, 'not learning to draw'", "kind": "complaint",
     "patterns": ["\\bcreativity\\b", "\\bfreedom\\b", "\\bout of the lines\\b", "\\bstrict\\b", "\\bcolou?ring book\\b", "\\bcolou?r by number\\b", "\\btrac(e|ing)\\b", "\\bnot going to help you learn\\b", "\\bdoesn'?t teach\\b", "\\blearn how to draw\\b", "\\bcreatividad\\b", "\\blibertad\\b", "\\bcalcar\\b", "\\bsolo (se )?traza\\b", "\\bno ense[ñn]a\\b", "\\bno aprendes\\b"]},
    {"id": "tools", "label": "Drawing tools: brushes, colours, undo, pen and stylus support", "kind": "complaint",
