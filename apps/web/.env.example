# Copy to .env.local (gitignored). Everything with the VITE_ prefix is compiled into the browser
# bundle, so only put public values here. Never a service_role key, never TICKET_SECRET.

# Base URL of the realtime Worker (wrangler dev listens on 8787).
VITE_REALTIME_URL=http://localhost:8787

# Supabase project URL and publishable (anon) key: Dashboard > Project Settings > API.
# Safe in the client: access is decided by row level security and the user's own token.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Cloudflare Turnstile site key (public). Only needed once the Worker has TURNSTILE_SECRET.
VITE_TURNSTILE_SITE_KEY=
